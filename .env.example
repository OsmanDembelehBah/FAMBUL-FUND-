# ==============================================================================
# Fambul Fund - Global Environment Configuration Template
# Copy this file to .env for local development: cp .env.example .env
# For production deployments, configure these values in your cloud host dashboards:
#   - Vercel (Frontend & Web API)
#   - Render / Railway (ussd-gateway & intelligence-service)
#   - Neon / Supabase (Serverless PostgreSQL)
#   - Upstash (Serverless Redis)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Server Environment
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=production
ENVIRONMENT=production

# ------------------------------------------------------------------------------
# 2. Next.js Public Client Configuration (Vercel)
# ------------------------------------------------------------------------------
# In production on Vercel, set this to your custom domain or Vercel URL
# Example: https://fambul-fund.vercel.app
NEXT_PUBLIC_API_URL=https://your-fambul-fund-domain.vercel.app

# ------------------------------------------------------------------------------
# 3. Serverless PostgreSQL Database (Neon or Supabase)
# ------------------------------------------------------------------------------
# Neon connection string example:
# postgresql://<user>:<password>@ep-aged-grass-123456.eu-central-1.aws.neon.tech/fambul_fund?sslmode=require
# Supabase connection string example (Transaction Pooler):
# postgres://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://fambul_user:YOUR_STRONG_PASSWORD@ep-sample-pool-123456.eu-central-1.aws.neon.tech/fambul_fund?sslmode=require

# ------------------------------------------------------------------------------
# 4. Authentication & JWT Cryptography
# ------------------------------------------------------------------------------
# Strong 64-char hex secret (Generate with: openssl rand -hex 32)
JWT_SECRET=replace_with_64_character_cryptographically_secure_random_hex_string

# ------------------------------------------------------------------------------
# 5. Serverless Redis Cache & Event Bus (Upstash)
# ------------------------------------------------------------------------------
# Upstash Redis connection URI (used for session caching & idempotent locks)
# Example: rediss://default:<password>@eu2-ample-lion-12345.upstash.io:6379
REDIS_URL=rediss://default:YOUR_UPSTASH_PASSWORD@eu2-sample-endpoint.upstash.io:6379

# ------------------------------------------------------------------------------
# 6. Backend Microservice Endpoints (Render / Railway)
# ------------------------------------------------------------------------------
# Deployed URL for the Go USSD & Telecom Gateway
USSD_GATEWAY_URL=https://fambul-fund-ussd-gateway.onrender.com

# Deployed URL for the Python Farm Intelligence & Satellite Service
INTELLIGENCE_SERVICE_URL=https://fambul-fund-intelligence-service.onrender.com

# ------------------------------------------------------------------------------
# 7. Sierra Leone Mobile Money Telecom Integration Keys (MNO Sandbox / Live)
# ------------------------------------------------------------------------------
ORANGE_MONEY_CLIENT_ID=om_client_sl_live_sample_placeholder
ORANGE_MONEY_CLIENT_SECRET=om_secret_sl_live_sample_placeholder
AFRIMONEY_API_KEY=afri_live_key_sample_placeholder
QMONEY_API_KEY=qm_live_key_sample_placeholder
MONIME_API_KEY=monime_api_key_sample_placeholder

# ------------------------------------------------------------------------------
# 8. Earth Observation & Parametric Weather APIs
# ------------------------------------------------------------------------------
# Copernicus Sentinel-2 Cloud API Key for multispectral NDVI farm boundary checks
COPERNICUS_SENTINEL_API_KEY=copernicus_sentinel_ndvi_sample_key
# Parametric drought & rainfall index API key
WEATHER_PARAMETRIC_API_KEY=raincheck_salone_sample_key
